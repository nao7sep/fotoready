{
  "name": "fotoready",
  "version": "0.1.0",
  "packageManager": "npm@12.0.2",
  "description": "FotoReady photo editor for blogging and publication workflows.",
  "main": "out/main/index.js",
  "author": "Yoshinao Inoguchi <yoshinao@inoguchi.com>",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "npm run typecheck:node && npm run typecheck:web && electron-vite build",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json",
    "typecheck:test": "tsc --noEmit -p tsconfig.test.json",
    "typecheck": "npm run typecheck:node && npm run typecheck:web && npm run typecheck:test",
    "preview": "electron-vite preview",
    "test": "vitest run",
    "check": "npm run typecheck && npm test",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "package": "npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder --publish never"
  },
  "dependencies": {
    "@google/genai": "^2.18.0",
    "@vitejs/plugin-react": "^5.2.0",
    "exiftool-vendored": "^37.2.0",
    "konva": "^10.3.1",
    "lucide-react": "^1.34.0",
    "nanoid": "^6.0.1",
    "p-queue": "^9.3.3",
    "piscina": "^5.3.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-konva": "^19.2.5",
    "sharp": "^0.35.3",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/node": "^26.3.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitest/coverage-v8": "^4.1.11",
    "electron": "^43.4.1",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "jsdom": "^30.0.1",
    "typescript": "^7.0.2",
    "vite": "^7.3.6",
    "vitest": "^4.1.11"
  },
  "allowScripts": {
    "@google/genai@2.18.0": false,
    "electron-winstaller@5.4.0": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.1": true,
    "fsevents@2.3.3": false,
    "protobufjs@7.6.5": false
  },
  "build": {
    "appId": "com.fotoready.desktop",
    "productName": "FotoReady",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*",
      "node_modules/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "**/node_modules/exiftool-vendored.*/**/*"
    ],
    "extraResources": [
      {
        "from": "resources/luts",
        "to": "luts"
      },
      {
        "from": "resources/stamps",
        "to": "stamps"
      },
      {
        "from": "build/Assets.car",
        "to": "Assets.car"
      }
    ],
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "mac": {
      "icon": "build/icon.icns",
      "identity": "-",
      "extendInfo": {
        "CFBundleIconName": "pancake-stack-bokeh"
      },
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64"
          ]
        }
      ]
    },
    "win": {
      "icon": "build/icon.ico",
      "target": [
        "nsis",
        "zip"
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "runAfterFinish": true
    }
  }
}
