{
  "name": "fotoready",
  "version": "0.1.0",
  "packageManager": "npm@12.2.0",
  "description": "Stack non-destructive edits on photos for publishing, choose exactly which metadata goes out with them, and batch-rename the results.",
  "main": "out/main/index.js",
  "author": "Yoshinao Inoguchi <yoshinao@inoguchi.com>",
  "license": "GPL-3.0-or-later",
  "type": "module",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "npm run typecheck:node && npm run typecheck:web && electron-vite build",
    "typecheck:node": "tsc --noEmit --composite false -p tsconfig.node.json",
    "typecheck:web": "tsc --noEmit --composite false -p tsconfig.web.json",
    "typecheck:test": "tsc --noEmit -p tsconfig.test.json",
    "typecheck": "npm run typecheck:node && npm run typecheck:web && npm run typecheck:test",
    "test": "npm run typecheck && vitest run",
    "test:full": "npm test && vitest run --config vitest.live.config.ts",
    "check:release-tag": "node scripts/check-release-tag.mjs",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "demo:records": "electron-vite build --config tests/dev/records-demo.config.ts && electron out/records-demo/main/records-demo.js",
    "check:package-inputs": "node scripts/check-package-inputs.mjs",
    "package": "npm run check:package-inputs && npm run build && npm run prepare:electron && electron-builder --dir",
    "dist": "npm run check:package-inputs && npm run build && npm run prepare:electron && electron-builder --publish never",
    "prepare:electron": "node node_modules/electron/install.js"
  },
  "dependencies": {
    "@google/genai": "^2.28.0",
    "exiftool-vendored": "^39.0.1",
    "konva": "^10.7.1",
    "lucide-react": "^1.55.0",
    "nanoid": "^6.0.2",
    "p-queue": "^10.0.0",
    "piscina": "^5.3.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-konva": "^19.3.0",
    "sharp": "^0.35.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@babel/parser": "^8.0.7",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.5",
    "electron": "^44.7.0",
    "electron-builder": "^26.17.0",
    "electron-vite": "^6.0.0",
    "jsdom": "^30.1.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  },
  "allowScripts": {
    "@google/genai@2.30.0": false,
    "electron-winstaller@5.4.0": true,
    "fsevents@2.3.3": false,
    "protobufjs@7.6.6": false
  },
  "build": {
    "appId": "com.fotoready.desktop",
    "productName": "FotoReady",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*",
      "node_modules/**/*",
      "package.json",
      "!**/*.map",
      "!**/*.d.ts",
      "!**/*.d.mts",
      "!**/*.d.cts"
    ],
    "asarUnpack": [
      "**/node_modules/exiftool-vendored.*/**/*"
    ],
    "extraResources": [
      {
        "from": "resources/luts",
        "to": "luts"
      },
      {
        "from": "resources/stamps",
        "to": "stamps"
      },
      {
        "from": "build/Assets.car",
        "to": "Assets.car"
      },
      {
        "from": "LICENSE",
        "to": "LICENSE.txt"
      }
    ],
    "mac": {
      "icon": "build/icon.icns",
      "identity": "-",
      "electronLanguages": [
        "en",
        "de",
        "es",
        "fr",
        "it",
        "pt_BR",
        "ru",
        "ja",
        "ko",
        "zh_CN"
      ],
      "extendInfo": {
        "CFBundleIconName": "pancake-stack-bokeh",
        "CFBundleLocalizations": [
          "en",
          "de",
          "es",
          "fr",
          "it",
          "pt-BR",
          "ru",
          "ja",
          "ko",
          "zh-Hans"
        ]
      },
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64"
          ]
        }
      ],
      "artifactName": "${productName}-${version}-mac.${ext}"
    },
    "dmg": {
      "artifactName": "${productName}-${version}.${ext}"
    },
    "win": {
      "icon": "build/icon.ico",
      "target": [
        "nsis",
        "zip"
      ],
      "artifactName": "${productName}-${version}-win.${ext}"
    },
    "nsis": {
      "artifactName": "${productName}-${version}-setup.${ext}",
      "oneClick": false,
      "perMachine": false,
      "allowElevation": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "runAfterFinish": true,
      "multiLanguageInstaller": true,
      "installerLanguages": [
        "en_US",
        "de_DE",
        "es_ES",
        "fr_FR",
        "it_IT",
        "pt_BR",
        "ru_RU",
        "ja_JP",
        "ko_KR",
        "zh_CN"
      ]
    }
  }
}
